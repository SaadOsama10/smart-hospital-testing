# Copy to .env and fill in, then export before running the backend or the Selenium suite:
#   set -a; source .env; set +a

# MySQL (used by Spring Boot and by RunSeleniumTests for test data setup/cleanup)
DB_URL=jdbc:mysql://localhost:3306/hospital_db
DB_USERNAME=root
DB_PASSWORD=change-me

# Password of the local self-signed keystore (src/main/resources/keystore.p12, dev profile)
SSL_KEYSTORE_PASSWORD=change-me

# Frontend origin allowed by the backend (prod profile)
APP_FRONTEND_URL=http://localhost:3000
